# ===== AI 对话 =====
# 提供方：doubao | qwen | deepseek
AI_PROVIDER=qwen

# 必填：在对应厂商控制台获取
# 豆包：https://www.volcengine.com/product/doubao
# 通义：https://dashscope.console.aliyun.com/
# DeepSeek：https://platform.deepseek.com/
AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 可选：模型名（不填则走 provider 默认）
# 豆包默认：doubao-pro-32k
# 通义默认：qwen-plus
# DeepSeek 默认：deepseek-chat
AI_MODEL=qwen-plus

# 可选：自定义 API base URL（不填走 provider 默认）
# AI_BASE_URL=https://your-custom-endpoint

# ===== 站点 =====
NEXT_PUBLIC_SITE_URL=https://your-domain.com
